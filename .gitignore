# Private reference archives and original user-provided material.
# Ignoring files does not redact them or grant redistribution rights.
/reference/
/inputs/
/uploads/
/private/

# Review transcripts, historical snapshots, raw run evidence and outputs.
/docs/reviews/
/validation/**/results/
/validation/**/history/
*.log
/runs/
/artifacts/
/test-results/
/playwright-report/
/tmp/
/temp/

# Local credentials: retain intentionally sanitized example templates only.
.env
.env.*
!.env.example
!.env.sample
!.env.template
.credentials/
credentials.json
.netrc
.aws/
.ssh/
*.pem
*.key
*.p12
*.pfx

# System and interpreter/tool caches.
.DS_Store
._*
__pycache__/
*.py[cod]
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
.coverage
htmlcov/

